# LLM Configuration
LLM_PROVIDER=openai          # openai | ollama | anthropic
OPENAI_API_KEY=sk-xxxx
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4o

# Anthropic (if using Claude)
ANTHROPIC_API_KEY=sk-ant-xxxx

# Ollama (local, reserved)
OLLAMA_HOST=http://localhost:11434
OLLAMA_MODEL=qwen2.5:7b

# ASR Configuration
ASR_PROVIDER=cloud           # cloud (OpenAI Whisper API) | local (faster-whisper)

# TTS Configuration
TTS_PROVIDER=edge            # edge (free) | openai | local

# Server
HOST=0.0.0.0
PORT=8000
LOG_LEVEL=info

# Avatar Runtime (reserved)
AVATAR_API_URL=http://localhost:9000
