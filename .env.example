# LLM Configuration
LLM_PROVIDER=deepseek        # openai | deepseek | ollama | anthropic
OPENAI_API_KEY=sk-xxxx
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4o

# DeepSeek (OpenAI-compatible)
DEEPSEEK_API_KEY=sk-xxxx
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-v4-flash

# Anthropic (if using Claude)
ANTHROPIC_API_KEY=sk-ant-xxxx

# Ollama (local, reserved)
OLLAMA_HOST=http://localhost:11434
OLLAMA_MODEL=qwen2.5:7b

# ASR Configuration
ASR_PROVIDER=local           # cloud (OpenAI Whisper API) | local (faster-whisper)
ASR_MODEL_SIZE=small
ASR_MODEL_PATH=
ASR_DEVICE=cuda
ASR_COMPUTE_TYPE=int8

# TTS Configuration
TTS_PROVIDER=edge            # edge (free) | openai | local

# Server
HOST=0.0.0.0
PORT=8000
LOG_LEVEL=info

# Avatar Runtime (reserved)
AVATAR_API_URL=http://localhost:9000
